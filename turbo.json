{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.local", "**/.env.*.local"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "DATABASE_URL",
    "DIRECT_URL",
    "AUTH_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_STORE_ID",
    "BLOB_SYNC_INTERVAL_MINUTES",
    "BACKOFFICE_API_KEY",
    "NEXT_PUBLIC_BLOG_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "REVALIDATION_SECRET",
    "JWT_SECRET",
    "REDIS_URL",
    "RESEND_API_KEY",
    "SLACK_WEBHOOK_URL",
    "SLACK_CHANNEL",
    "NOTIFICATION_EMAILS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build:rpc": {
      "dependsOn": ["^build:rpc"],
      "outputs": ["dist/**/*.js", "dist/**/*.d.ts", "dist/**/*.mjs"],
      "cache": true
    },
    "@apps/blog#build": {
      "dependsOn": ["@apps/blog-admin#build:rpc", "^build", "generate:prisma"]
    },
    "@apps/blog-admin#build": {
      "dependsOn": ["@apps/rag-gateway#build", "^build", "generate:prisma"],
      "env": ["RAG_GATEWAY_API_KEY", "NEXT_PUBLIC_RAG_GATEWAY_URL"]
    },
    "@apps/rag-gateway#build": {
      "dependsOn": ["^build"],
      "env": [
        "QDRANT_URL",
        "QDRANT_API_KEY",
        "OPENAI_API_KEY",
        "GLM_API_KEY",
        "LLM_PROVIDER",
        "EMBEDDING_PROVIDER",
        "EMBEDDING_MODEL",
        "RAG_GATEWAY_API_KEY",
        "BLOG_ADMIN_URL",
        "SLACK_WEBHOOK_URL",
        "SLACK_CHANNEL",
        "NOTIFICATION_EMAILS",
        "RESEND_API_KEY"
      ]
    },
    "generate:prisma": {
      "dependsOn": ["^generate:prisma"],
      "outputs": ["prisma/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
