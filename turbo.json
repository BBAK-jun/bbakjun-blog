{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "DATABASE_URL",
    "DIRECT_URL",
    "AUTH_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_STORE_ID",
    "BLOB_SYNC_INTERVAL_MINUTES",
    "BACKOFFICE_API_KEY",
    "NEXT_PUBLIC_BLOG_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "BLOG_REVALIDATION_SECRET",
    "REVALIDATION_SECRET",
    "JWT_SECRET",
    "REDIS_URL",
    "RESEND_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "AUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_STORE_ID",
        "BLOB_SYNC_INTERVAL_MINUTES",
        "BACKOFFICE_API_KEY",
        "NEXT_PUBLIC_BLOG_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "BLOG_REVALIDATION_SECRET",
        "REVALIDATION_SECRET",
        "JWT_SECRET",
        "REDIS_URL",
        "RESEND_API_KEY"
      ]
    },
    "build:rpc": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    }
  }
}
