{
  "name": "blog-admin",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./rpc": {
      "types": "./dist/rpc/types.d.mts",
      "import": "./dist/rpc/types.mjs",
      "default": "./dist/rpc/types.mjs"
    },
    "./contract": {
      "types": "./dist/contract/index.d.mts",
      "import": "./dist/contract/index.mjs",
      "default": "./dist/contract/index.mjs"
    }
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "build:rpc": "tsup --config tsup.config.ts",
    "start": "next start -p 3001",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate && pnpm build:rpc"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hono/node-server": "^1.19.7",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@repo/analytics": "workspace:*",
    "@repo/content": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.12",
    "@uiw/react-codemirror": "^4.25.4",
    "@vercel/blob": "^0.23.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.11.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.553.0",
    "next": "16.0.8",
    "next-auth": "5.0.0-beta.30",
    "nuqs": "^2.8.5",
    "overlay-kit": "^1.8.6",
    "pg": "^8.16.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "resend": "^6.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
