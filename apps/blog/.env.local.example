# Post Source
# 'filesystem' - Read from local packages/content/posts folder
# 'blob' - Read from Vercel Blob Storage
POST_SOURCE=blob

# Vercel Blob Token (required when POST_SOURCE=blob)
# Get this from Vercel Dashboard → Storage → Blob → Show secret value
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# Redis (Vercel KV) for view tracking
REDIS_URL=your_redis_url_here

# Site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blog Admin URL for API calls
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Giscus (optional, for comments)
NEXT_PUBLIC_GISCUS_REPO_ID=your_repo_id
