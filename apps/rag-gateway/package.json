{
  "name": "@apps/rag-gateway",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prebuild": "pnpm install --no-frozen-lockfile",
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "catalog:hono",
    "@hono/zod-openapi": "catalog:hono",
    "@hono/zod-validator": "catalog:hono",
    "@qdrant/js-client-rest": "^1.15.1",
    "@repo/cache": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.30",
    "@t3-oss/env-nextjs": "^0.10.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "hono": "catalog:hono",
    "hono-pino": "catalog:hono",
    "openai": "^4.28.4",
    "pino": "catalog:pino",
    "pino-pretty": "catalog:pino",
    "stoker": "^2.0.1",
    "zod": "catalog:zod"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "tsup": "catalog:tsup",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.4"
  }
}
