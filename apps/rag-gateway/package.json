{
  "name": "@apps/rag-gateway",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./rpc": {
      "types": "./dist/rpc/index.d.mts",
      "import": "./dist/rpc/index.mjs",
      "default": "./dist/rpc/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "build:rpc": "tsup --config tsup.rpc.config.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/zod-openapi": "^0.16.4",
    "@hono/zod-validator": "^0.7.6",
    "@qdrant/js-client-rest": "^1.15.1",
    "@scalar/hono-api-reference": "^0.9.30",
    "@t3-oss/env-nextjs": "^0.10.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.5",
    "hono-pino": "^0.10.3",
    "openai": "^4.28.4",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "stoker": "^2.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.4"
  }
}
