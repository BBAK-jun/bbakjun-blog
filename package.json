{
  "name": "bbakjun-blog-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:blog": "turbo run dev --filter=blog",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "build": "turbo run build",
    "build:blog": "turbo run build --filter=blog",
    "build:dashboard": "turbo run build --filter=dashboard",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.5.1",
    "turbo": "^2.6.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=20"
  }
}
