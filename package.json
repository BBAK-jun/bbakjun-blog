{
  "name": "bbakjun-blog-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:blog": "turbo run dev --filter=blog",
    "dev:admin": "turbo run dev --filter=blog-admin",
    "dev:all": "turbo run dev --filter=blog --filter=blog-admin",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "build": "turbo run build",
    "build:blog": "turbo run build --filter=blog",
    "build:admin": "turbo run build --filter=blog-admin",
    "build:dashboard": "turbo run build --filter=dashboard",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "upload-posts": "node scripts/upload-posts.js",
    "upload-posts:prod": "NEXT_PUBLIC_ADMIN_URL=https://bbakjun-blog-admin.vercel.app node scripts/upload-posts.js"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "turbo": "^2.6.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24"
  }
}
