# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated declaration files (repo policy: do not commit)
apps/blog-admin/src/rpc/**/*.d.ts
apps/blog-admin/src/shared/lib/auth/**/*.d.ts
apps/blog-admin/src/lib/**/*.d.ts

# turborepo
.turbo
*/.turbo
apps/blog/.next/

# blog generated (OpenAPI types)
apps/blog/src/generated/
