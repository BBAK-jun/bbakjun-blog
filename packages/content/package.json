{
  "name": "@repo/content",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./posts": {
      "types": "./dist/posts.d.ts",
      "default": "./dist/posts.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/posts.ts src/markdown.ts src/rehype-mermaid.ts --format esm,cjs --dts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "gray-matter": "^4.0.3",
    "reading-time": "^1.5.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "rehype-slug": "^6.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "hastscript": "^9.0.1"
  },
  "devDependencies": {
    "@types/hast": "^3",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
